# GitHub Repository Status Tracker - Environment Variables
# Copy this file to .env and fill in your values

# GitHub Personal Access Token (required)
# Create one at: https://github.com/settings/tokens
# Needs: repo (public_repo for public repos), read:org, read:user
GH_TOKEN=your_github_personal_access_token_here

# GitHub Username (default: NotHarshhaa)
GH_USERNAME=NotHarshhaa

# Configuration file path (default: repos.json)
CONFIG_FILE=repos.json

# README file path (default: README.md)
README_FILE=README.md

# Next.js / Dashboard
NEXT_PUBLIC_SITE_URL=https://your-domain.com